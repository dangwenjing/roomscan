<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="#212121"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:text="@string/home_subtitle"
        android:textColor="#757575"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnMeasure"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/home_measure"
        android:textSize="17sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="@string/home_measure_desc"
        android:textColor="#757575"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnAuto"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/home_auto"
        android:textSize="17sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp"
        android:gravity="center"
        android:text="@string/home_auto_desc"
        android:textColor="#757575"
        android:textSize="13sp" />

    <Button
        android:id="@+id/btnAr"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="@string/home_ar"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/arStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:textColor="#757575"
        android:textSize="13sp" />
</LinearLayout>
